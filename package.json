{
  "name": "navi-serverless",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JohnEsleyer/navi-serverless.git"
  },
  "homepage": "https://github.com/JohnEsleyer/navi-serverless#readme",
  "bugs": {
    "url": "https://github.com/JohnEsleyer/navi-serverless/issues"
  },
  "description": "Opinionated, strictly TypeScript edge framework for V8 runtimes (Cloudflare Workers, Vercel Edge, Deno, Bun) engineered to drive paid function invocations toward zero.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "edge",
    "serverless",
    "cloudflare-workers",
    "vercel-edge",
    "v8",
    "workers",
    "singleflight",
    "zero-invocation",
    "typescript"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "default": "./dist/adapters.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "bun run examples/dev.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.cloudflare.json --noEmit",
    "test": "bun test",
    "demo": "bun run examples/local-bun.ts",
    "check": "bun run typecheck && bun test && bun run build"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/bun": "^1.4.2",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": "^4"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    }
  }
}
